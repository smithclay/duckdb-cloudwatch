# name: test/sql/cloudwatch.test
# description: offline CloudWatch Logs extension tests
# group: [sql]

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example');
----
does not exist

require cloudwatch

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'read_cloudwatch_logs';
----
true

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'read_cloudwatch_service_dependencies';
----
true

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'send_cloudwatch_logs';
----
true

# The sender validates its OTLP-shaped input and constant destination before credential lookup.
statement error
DESCRIBE SELECT send_cloudwatch_logs('not a struct', '/app/logs', 'duckdb');
----
must be a STRUCT

statement error
DESCRIBE SELECT send_cloudwatch_logs({'body': 'hello'}, '', 'duckdb');
----
log_group must not be empty

statement error
DESCRIBE SELECT send_cloudwatch_logs({'body': 'hello'}, '/app/logs', 'bad:*');
----
log_stream must not contain

statement error
DESCRIBE SELECT send_cloudwatch_logs({'body': 'hello'}, log_group, 'duckdb')
FROM (VALUES ('/app/logs')) destinations(log_group);
----
log_group must be a constant string

# With a valid destination, sender credentials resolve from the same aws/s3 secret chain as reads.
statement error
DESCRIBE SELECT send_cloudwatch_logs({'body': 'hello'}, '/app/logs', 'duckdb');
----
No AWS credentials found

# ATTACH option validation is performed before AWS credential lookup, keeping these catalog
# tests offline. Successful catalog attachment is covered by the integration smoke test.
statement error
ATTACH 'not-cloudwatch:' AS cw_bad_path (TYPE cloudwatch, LOG_GROUPS []);
----
must be attached from the path 'cloudwatch:'

statement error
ATTACH 'cloudwatch:' AS cw_bad_groups (TYPE cloudwatch, LOG_GROUPS ['']);
----
LOG_GROUPS must not contain empty names

statement error
ATTACH 'cloudwatch:' AS cw_bad_page (TYPE cloudwatch, LOG_GROUPS []::VARCHAR[], PAGE_SIZE 0);
----
page_size must be between 1 and 10000

statement error
ATTACH 'cloudwatch:' AS cw_bad_option (TYPE cloudwatch, LOG_GROUPS []::VARCHAR[], UNKNOWN 'value');
----
Unsupported CloudWatch ATTACH option 'unknown'

statement error
ATTACH 'cloudwatch:' AS cw_bad_xray_group (
    TYPE cloudwatch,
    LOG_GROUPS []::VARCHAR[],
    XRAY_GROUP_NAME 'production',
    XRAY_GROUP_ARN 'arn:aws:xray:us-east-1:123456789012:group/production/example'
);
----
mutually exclusive

statement error
ATTACH 'cloudwatch:' AS cw_bad_monitoring_endpoint (
    TYPE cloudwatch,
    LOG_GROUPS []::VARCHAR[],
    MONITORING_ENDPOINT 'ftp://monitoring.example.test'
);
----
endpoint scheme must be HTTP or HTTPS

statement error
ATTACH 'cloudwatch:' AS cw_ambiguous_logs_endpoint (
    TYPE cloudwatch,
    LOG_GROUPS []::VARCHAR[],
    ENDPOINT 'https://logs.us-east-1.amazonaws.com',
    LOGS_ENDPOINT 'https://logs.us-west-2.amazonaws.com'
);
----
aliases and mutually exclusive

# Credentials are resolved at bind time and use DuckDB's AWS secret format.
statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example');
----
No AWS credentials found

# Argument validation is deliberately performed before credential lookup, keeping these tests
# offline and making configuration mistakes deterministic.
statement error
SELECT * FROM read_cloudwatch_logs('');
----
log_group must not be empty

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example', page_size => 0);
----
page_size must be between 1 and 10000

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example', page_size => 10001);
----
page_size must be between 1 and 10000

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example', max_rows => -1);
----
max_rows must be >= 0

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example', retries => -1);
----
retries must be >= 0

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example', timeout => 0);
----
timeout must be >= 1

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example', "order" => 'newest');
----
order must be either 'asc' or 'desc'

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example',
                                   log_stream_prefix => '2026/',
                                   log_streams => ['2026/08/03/[$LATEST]abc']);
----
mutually exclusive

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example', unknown_option => true);
----
Invalid named parameter

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example', endpoint => 'https://logs.example.test/api');
----
endpoint must be an origin

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example', endpoint => 'ftp://logs.example.test');
----
endpoint scheme must be HTTP or HTTPS

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example', endpoint => 'https://');
----
endpoint must include a host

statement error
SELECT * FROM read_cloudwatch_logs('/aws/lambda/example', endpoint => 'http://logs.example.test');
----
plaintext HTTP endpoints are allowed only on loopback

statement error
SELECT * FROM read_cloudwatch_service_dependencies(group_name => 'production', group_arn => 'arn:group');
----
mutually exclusive

statement error
SELECT * FROM read_cloudwatch_service_dependencies(retries => -1);
----
retries must be between 0 and 100

statement error
SELECT * FROM read_cloudwatch_service_dependencies(timeout => 0);
----
timeout must be >= 1 second

statement error
SELECT * FROM read_cloudwatch_service_dependencies(xray_endpoint => 'https://xray.example.test/path');
----
endpoint must be an origin

# --- Logs Insights -------------------------------------------------------------

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'read_cloudwatch_logs_insights';
----
true

# Insights argument validation also runs before credential lookup.
statement error
SELECT * FROM read_cloudwatch_logs_insights('fields @message');
----
pass at least one log group

statement error
SELECT * FROM read_cloudwatch_logs_insights('', log_groups => ['/aws/lambda/example']);
----
query string must not be empty

statement error
SELECT * FROM read_cloudwatch_logs_insights('fields @message', log_groups => []::VARCHAR[]);
----
pass at least one log group

statement error
SELECT * FROM read_cloudwatch_logs_insights('fields @message', log_groups => ['']);
----
log group names must not be empty

statement error
SELECT * FROM read_cloudwatch_logs_insights('fields @message', log_groups => ['/a'], max_rows => 10001);
----
max_rows must be between 0 and 10000

# `limit` is accepted as the API's own spelling, but DuckDB's parser requires it quoted.
statement error
SELECT * FROM read_cloudwatch_logs_insights('fields @message', log_groups => ['/a'], "limit" => -1);
----
max_rows must be between 0 and 10000

statement error
SELECT * FROM read_cloudwatch_logs_insights('fields @message', log_groups => ['/a'], max_wait => 0);
----
max_wait must be >= 1 second

statement error
SELECT * FROM read_cloudwatch_logs_insights('fields @message', log_groups => ['/a'], poll_interval_ms => 1);
----
poll_interval_ms must be >= 10

statement error
SELECT * FROM read_cloudwatch_logs_insights('fields @message', log_groups => ['/a'],
                                            start_time => 'now', end_time => '-1h');
----
end_time must not be before start_time

statement error
SELECT * FROM read_cloudwatch_logs_insights('fields @message', log_groups => ['/a'],
                                            endpoint => 'http://logs.example.test');
----
plaintext HTTP endpoints are allowed only on loopback

# A query over more than 50 log groups is rejected locally rather than by AWS.
statement error
SELECT * FROM read_cloudwatch_logs_insights('fields @message',
    log_groups => str_split(rtrim(repeat('/g,', 51), ','), ','));
----
at most 50 log groups

statement error
SELECT * FROM read_cloudwatch_logs_insights('fields @message', log_groups => ['/a']);
----
No AWS credentials found

# --- log-group administration --------------------------------------------------

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'create_cloudwatch_log_group';
----
true

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'delete_cloudwatch_log_group';
----
true

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'create_cloudwatch_log_stream';
----
true

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'put_cloudwatch_retention_policy';
----
true

# Retention values are checked against the set CloudWatch accepts, since AWS's own error does not
# name the valid values.
statement error
SELECT put_cloudwatch_retention_policy('/app/logs', 2);
----
retention_days must be one of

statement error
SELECT create_cloudwatch_log_group('/app/logs', 'missing_secret');
----
not found

# --- cloudwatch_serve ----------------------------------------------------------

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'cloudwatch_serve';
----
true

statement error
SELECT cloudwatch_serve('http:localhost:10540');
----
expected 'cloudwatch:host[:port]'

statement error
SELECT cloudwatch_serve('cloudwatch:localhost:0');
----
Invalid CloudWatch listen port

# Binding anywhere but loopback is opt-in, so a stray serve cannot expose the host by accident.
statement error
SELECT cloudwatch_serve('cloudwatch:0.0.0.0:10541');
----
Only localhost is allowed

statement error
SELECT cloudwatch_serve('cloudwatch:localhost:10542', {'unknown_option': true});
----
Unsupported cloudwatch_serve option

query I
SELECT cloudwatch_stop('cloudwatch:localhost:10543');
----
not found

# --- send_cloudwatch_metrics ---------------------------------------------------

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'send_cloudwatch_metrics';
----
true

statement error
DESCRIBE SELECT send_cloudwatch_metrics('not a struct', '/obsbench/run1');
----
must be a STRUCT

# The value column is what makes a gauge a gauge; a struct without one is a bind error, not an
# empty send.
statement error
DESCRIBE SELECT send_cloudwatch_metrics({'name': 'cpu'}, '/obsbench/run1');
----
needs a 'double_value' or 'value' column

statement error
DESCRIBE SELECT send_cloudwatch_metrics({'name': 'cpu', 'double_value': 1.0}, 'AWS/EC2');
----
reserved for AWS services

statement error
DESCRIBE SELECT send_cloudwatch_metrics({'name': 'cpu', 'double_value': 1.0}, '');
----
must not be empty

# The namespace must be a constant: a destination that varied per row could not be batched, and
# would turn row data into an AWS resource name.
statement error
DESCRIBE SELECT send_cloudwatch_metrics(m, m.name) FROM (SELECT {'name': 'cpu', 'double_value': 1.0} AS m) t;
----
must be a constant string
